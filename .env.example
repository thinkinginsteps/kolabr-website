# Public (exposed to the browser, inlined at BUILD time: changing one means rebuilding)

# Base URL of the Kolabr app. Sign in links here; /signup/ redirects here. Not yet decided.
NEXT_PUBLIC_APP_URL=
# Google Tag Manager container. Defaults to the live container (GTM-M37PVG29) in lib/site.ts,
# so this only needs setting to override it: another container for staging, or empty to switch
# tag manager off entirely.
NEXT_PUBLIC_GTM_ID=
# Google Analytics measurement ID (G-XXXXXXXXXX), for loading GA4 directly without a container.
# Ignored when a GTM container is set, so GA4 is not counted twice. Configure GA4 inside GTM.
NEXT_PUBLIC_GA_ID=

# Server only (used by the contact form BFF in app/api/contact). Never prefix with NEXT_PUBLIC_.

RESEND_API_KEY=
# Where contact form messages are delivered.
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=

# Back office (server only). The site runs without these; the back office does not.
# Generate the hash with: node scripts/create-admin-password.mjs 'your password'
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Where the server keeps what a deploy must not overwrite. Absolute paths, set by the systemd
# unit in production; the defaults are fine locally.
# CONTENT_DIR=/opt/kolabr/content
# STATE_DIR=/opt/kolabr/state
# UPLOAD_DIR=/opt/kolabr/uploads
# DEPLOY_SCRIPT=/opt/kolabr/deploy.sh
# DEPLOY_LOG_DIR=/opt/kolabr/deploy-logs
