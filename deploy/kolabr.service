ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kolabr/uploads /opt/kolabr/state /opt/kolabr/content
# PrivateTmp is deliberately OFF: an uploaded package has to be readable by the deploy script,
# which runs as root in its own unit. With a private /tmp it would not be, so uploads go to
# /opt/kolabr/uploads instead and /tmp is never used to hand files between the two.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
